# Copia este archivo como "keystore.properties" (NO lo subas a git) y completa los datos.
# Genera el keystore una sola vez con:
#   keytool -genkeypair -v -keystore reservas.jks -alias reservas -keyalg RSA -keysize 2048 -validity 10000
storeFile=reservas.jks
storePassword=CAMBIAR
keyAlias=reservas
keyPassword=CAMBIAR
